<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg_light">
    <TextView android:id="@+id/pLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Biggest category" android:textSize="11sp" android:textStyle="bold" android:textColor="#767676" />
    <TextView android:id="@+id/pName" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"
        android:layout_marginTop="2dp" android:textColor="#1B6EF3" />
    <TextView android:id="@+id/pAmount" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="₹0" android:textSize="24sp" android:textStyle="bold" android:includeFontPadding="false"
        android:maxLines="1" android:ellipsize="end" android:textColor="#1B6EF3" />
    <TextView android:id="@+id/pSub" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:textColor="#767676" />
    <ImageView android:id="@+id/pBar" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="8dp" android:scaleType="fitXY"
        android:contentDescription="@string/widget_topcat_desc" />
</LinearLayout>
