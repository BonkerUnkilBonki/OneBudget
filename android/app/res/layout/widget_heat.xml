<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="13dp" android:background="@drawable/widget_bg_light">
    <TextView android:id="@+id/hLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/widget_this_month" android:textSize="11sp" android:textStyle="bold" android:textColor="#767676" />
    <TextView android:id="@+id/hAmount" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="₹0" android:textSize="22sp" android:textStyle="bold" android:includeFontPadding="false"
        android:maxLines="1" android:ellipsize="end" android:textColor="#1B6EF3" />
    <TextView android:id="@+id/hSub" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:textColor="#767676" />
    <ImageView android:id="@+id/hGrid" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="7dp" android:scaleType="fitCenter"
        android:contentDescription="@string/widget_heat_desc" />
</LinearLayout>
