<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg_light">

    <TextView
        android:id="@+id/wLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_this_month"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#767676" />

    <TextView
        android:id="@+id/wMonth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₹0"
        android:textSize="27sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#1B6EF3" />

    <TextView
        android:id="@+id/wToday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/widget_empty_sub"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#767676" />

    <TextView
        android:id="@+id/wTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text=""
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#767676" />

    <TextView
        android:id="@+id/wAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:paddingLeft="13dp"
        android:paddingRight="13dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@drawable/widget_pill"
        android:text="@string/widget_add"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF" />
</LinearLayout>
