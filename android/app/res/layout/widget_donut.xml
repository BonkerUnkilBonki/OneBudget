<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp"
    android:background="@drawable/widget_bg_light">
    <TextView android:id="@+id/dLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/widget_by_category" android:textSize="11sp" android:textStyle="bold" android:textColor="#767676" />
    <ImageView android:id="@+id/dRing" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="4dp" android:scaleType="fitCenter"
        android:contentDescription="@string/widget_donut_desc" />
    <TextView android:id="@+id/dLegend" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"
        android:layout_marginTop="4dp" android:textColor="#191919" />
</LinearLayout>
